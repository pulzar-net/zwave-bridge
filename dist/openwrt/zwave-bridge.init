#!/bin/sh /etc/rc.common
# zwave-bridge on OpenWrt (procd).
#
#   cp zwave-bridge.init /etc/init.d/zwave-bridge
#   chmod +x /etc/init.d/zwave-bridge
#   /etc/init.d/zwave-bridge enable
#   /etc/init.d/zwave-bridge start
#
# /var is in RAM on OpenWrt: set [store] dir to a directory on flash, such as
# /etc/zwave-bridge/data, or the network keys are lost at reboot.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/zwave-bridge
CONFIG=/etc/zwave-bridge/config.toml

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" --config "$CONFIG"
	procd_set_param env RUST_LOG=info
	procd_set_param file "$CONFIG"
	# Restart forever, 5 s apart, including after an NVM restore.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
